# Gene-Guard Backend Configuration

# Gemini API Key - Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=5050
NODE_ENV=development

# MongoDB Configuration
# For local development: mongodb://localhost:27017/gene-guard
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/gene-guard?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/gene-guard
